{
  "manifest_version": 3,
  "name": "X Media Search Button",
  "version": "1.0.0",
  "description": "Xのプロフィール欄にメディア検索ボタンを追加",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
